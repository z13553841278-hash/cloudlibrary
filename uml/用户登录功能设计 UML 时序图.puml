@startuml
actor 用户
participant "登录控制器" as LoginController
participant "登录服务" as LoginService
participant "用户DAO" as UserDao
participant "HttpSession" as Session

用户 -> LoginController: 提交登录信息(用户名,密码)
LoginController -> LoginService: 调用login(username,password)
LoginService -> UserDao: 调用findByUsername(username)
UserDao --> LoginService: 返回用户对象
alt 用户不存在
    LoginService --> LoginController: 返回登录失败
else 用户存在
    LoginService -> LoginService: 验证密码
    alt 密码错误
        LoginService --> LoginController: 返回登录失败
    else 密码正确
        LoginService -> Session: 调用setAttribute("loginUser",user)
        LoginService --> LoginController: 返回登录成功
    end
end
LoginController --> 用户: 显示登录结果(跳转页面)
@enduml